# Set to the canonical HTTPS origin when a production domain is connected.
# Example: NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SITE_URL=

# Supabase (publishable key is safe for browser use; RLS remains mandatory).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional aliases used when an imported Vercel secret cannot be converted to Config.
NEXT_PUBLIC_GENKS_SUPABASE_URL=
NEXT_PUBLIC_GENKS_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe test/live keys. Prices are always resolved server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GENKS <orders@example.com>
GENKS_CONTACT_EMAIL=prod.genks@gmail.com

# Shared studio calendar. Share the calendar with the service-account email as Editor.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GENKS_ADMIN_EMAIL=prod.genks@gmail.com

# Direct contact actions.
NEXT_PUBLIC_GENKS_INSTAGRAM=https://instagram.com/prodbygenks
NEXT_PUBLIC_GENKS_TIKTOK=https://tiktok.com/@prodbygenks
NEXT_PUBLIC_GENKS_YOUTUBE=https://youtube.com/@prodbygenks
NEXT_PUBLIC_GENKS_WHATSAPP=
